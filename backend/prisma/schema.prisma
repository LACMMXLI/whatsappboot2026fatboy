generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum UserRole {
  ADMIN
  AGENT
}

/// Flujo guiado: IDLE -> (si falta el nombre) ASKING_NAME -> (si hay promos
/// activas) ASKING_PROMOTIONS -> BROWSING_PROMOTIONS o BROWSING_CATEGORIES
/// -> BROWSING_MENU (productos de UNA categoria, ya no el catalogo completo)
/// -> BUILDING_ORDER -> CONFIRMING_ORDER -> ORDER_CREATED. El negocio es
/// solo pickup, no hay paso de eleccion de domicilio/entrega.
enum ConversationStatus {
  IDLE
  ASKING_NAME
  ASKING_PROMOTIONS
  BROWSING_PROMOTIONS
  BROWSING_CATEGORIES
  BROWSING_MENU
  BUILDING_ORDER
  CONFIRMING_ORDER
  ORDER_CREATED
}

enum MessageDirection {
  IN
  OUT
}

enum MessageSenderType {
  /// Mensaje entrante real del cliente.
  CUSTOMER
  /// Respuesta generada por el motor automatico del bot.
  BOT
  /// Mensaje enviado manualmente desde el CRM por un usuario autenticado.
  AGENT
  /// Nota interna visible en el timeline (no se envia por WhatsApp), ej.
  /// "conversacion asignada", "bot desactivado", "chat resuelto".
  SYSTEM
  /// Generado por una integracion externa (POS, campanias, automatizaciones
  /// futuras) distinta del motor de bot propio.
  INTEGRATION
}

enum MessageType {
  TEXT
  IMAGE
  AUDIO
  VIDEO
  DOCUMENT
  OTHER
}

enum OrderStatus {
  DRAFT
  CONFIRMED
  SENT_TO_POS
  READY
  DELIVERED
  CANCELLED
}

enum FulfillmentType {
  PICKUP
  DELIVERY
}

/// Estado de la conexion de WhatsApp (instancia de Evolution API) del negocio.
enum WhatsappConnectionStatus {
  /// Todavia no se intento crear la instancia (negocio recien creado).
  PENDING
  /// Instancia creada, esperando que escaneen el QR.
  CONNECTING
  /// WhatsApp conectado y funcionando.
  CONNECTED
  /// Se desconecto (logout) pero la instancia sigue existiendo.
  DISCONNECTED
  /// Fallo crear/conectar la instancia (ej. Evolution API no disponible).
  /// whatsappConnectionError tiene el detalle; se puede reintentar.
  ERROR
}

/// Mensajes cortos y autocontenidos del bot que un negocio puede
/// personalizar (texto libre). Las respuestas con listas dinamicas (menu,
/// resumen de carrito) NO son configurables aca: se siguen generando con
/// datos reales del catalogo/pedido, no tiene sentido volverlas texto libre.
enum BotTemplateKey {
  GREETING
  CANCEL
  HUMAN_HANDOFF
  FALLBACK
}

/// Intenciones que un negocio puede extender con frases/palabras propias
/// (ademas de las reglas por defecto del bot). "order"/"add_product" quedan
/// afuera a proposito: esas se detectan por catalogo, no por palabra clave.
enum BotIntentType {
  greeting
  view_menu
  confirm
  cancel
  talk_to_human
}

// ---------------------------------------------------------------------------
// Multi-tenant core
// ---------------------------------------------------------------------------

model Business {
  id                       String                   @id @default(cuid())
  name                     String
  /// Nombre de la instancia de Evolution API (unico). Se genera solo al
  /// crear el negocio desde el panel superadmin.
  whatsappInstanceId       String?
  whatsappConnectionStatus WhatsappConnectionStatus @default(PENDING)
  /// Detalle del ultimo error al crear/conectar la instancia (solo si
  /// whatsappConnectionStatus = ERROR). Se limpia al reintentar con exito.
  whatsappConnectionError  String?
  /// Direccion donde el cliente recoge su pedido. El negocio solo maneja
  /// servicio de recoleccion (pickup) por ahora, sin domicilio.
  pickupAddress            String?
  /// Interruptor maestro: si es false, el bot no responde en NINGUNA
  /// conversacion del negocio, sin importar el botEnabled de cada
  /// conversacion individual. Pensado para pausar todo (cerrado, mantenimiento).
  botEnabled               Boolean                  @default(true)
  waitingThresholdMinutes  Int                      @default(3)
  /// Si es true, PATCH /conversations/:id/release-control reactiva el bot al
  /// liberar el control humano, salvo que la request indique explicitamente
  /// lo contrario con { reactivateBot: false }.
  reactivateBotOnRelease   Boolean                  @default(false)
  createdAt                DateTime                 @default(now())
  updatedAt                DateTime                 @updatedAt

  users         User[]
  customers     Customer[]
  conversations Conversation[]
  messages      Message[]
  products      Product[]
  promotions    Promotion[]
  orders        Order[]
  botTemplates  BotResponseTemplate[]
  botKeywords   BotKeywordRule[]

  @@map("businesses")
}

model User {
  id                  String    @id @default(cuid())
  businessId          String
  email               String    @unique
  passwordHash        String
  name                String
  role                UserRole  @default(ADMIN)
  /// Dueño de la plataforma (vos): puede entrar al panel /superadmin y ver
  /// TODOS los negocios, ademas de operar el suyo propio como cualquier
  /// ADMIN normal. No tiene nada que ver con el rol dentro de su negocio.
  isSuperAdmin        Boolean   @default(false)
  /// Cantidad de intentos de login fallidos consecutivos. Se resetea a 0 en
  /// cada login exitoso. Usado junto con lockedUntil para bloquear la CUENTA
  /// (no solo la IP) ante fuerza bruta distribuida. Ver AuthService.login.
  failedLoginAttempts Int       @default(0)
  /// Si esta en el futuro, el login se rechaza aunque la contraseña sea
  /// correcta (cuenta bloqueada temporalmente por demasiados intentos
  /// fallidos). Se limpia solo (vuelve a null) en el siguiente login exitoso
  /// una vez que la fecha ya paso.
  lockedUntil         DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  business              Business             @relation(fields: [businessId], references: [id], onDelete: Cascade)
  assignedConversations Conversation[]
  sentMessages          Message[]            @relation("MessageSender")
  passwordResetTokens   PasswordResetToken[]

  @@index([businessId])
  @@map("users")
}

/// Token de un solo uso para "olvide mi contraseña". Solo se guarda el HASH
/// (sha256) del token, nunca el valor crudo: el crudo va por email y no debe
/// poder reconstruirse a partir de la base de datos. Ver AuthService.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  /// Se completa cuando el token se usa para cambiar la contraseña. Un
  /// token usado nunca se vuelve a aceptar aunque no haya vencido.
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

// ---------------------------------------------------------------------------
// CRM
// ---------------------------------------------------------------------------

model Customer {
  id         String   @id @default(cuid())
  businessId String
  phone      String
  name       String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  business      Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  conversations Conversation[]
  orders        Order[]

  @@unique([businessId, phone])
  @@index([businessId])
  @@map("customers")
}

model Conversation {
  id                    String             @id @default(cuid())
  businessId            String
  customerId            String
  state                 ConversationStatus @default(IDLE)
  botEnabled            Boolean            @default(true)
  assignedUserId        String?
  context               Json               @default("{}")
  lastMessageAt         DateTime?
  lastInboundMessageAt  DateTime?
  lastOutboundMessageAt DateTime?
  unreadCount           Int                @default(0)
  automationError       String?
  resolvedAt            DateTime?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  business     Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer     Customer   @relation(fields: [customerId], references: [id], onDelete: Cascade)
  assignedUser User?      @relation(fields: [assignedUserId], references: [id], onDelete: SetNull)
  messages     Message[]
  orders       Order[]
  botStates    BotState[]

  @@index([businessId])
  @@index([businessId, state])
  @@map("conversations")
}

/// senderType se asigna SIEMPRE en el servidor (nunca lo elige el frontend):
/// el webhook de WhatsApp escribe CUSTOMER, el motor del bot escribe BOT, el
/// endpoint /messages/send fuerza AGENT + senderUserId desde el JWT, y las
/// notificaciones del POS usan INTEGRATION. SYSTEM queda reservado para notas
/// internas que no se reenvian al cliente.
/// Nota de migracion (si se aplicara sobre una base con datos reales
/// preexistentes): backfill direction=IN -> CUSTOMER, direction=OUT -> el
/// dato historico no distingue bot de agente, backfillear a INTEGRATION o
/// SYSTEM segun corresponda; nunca asumir BOT/AGENT sin evidencia.
model Message {
  id                 String            @id @default(cuid())
  businessId         String
  conversationId     String
  direction          MessageDirection
  type               MessageType       @default(TEXT)
  senderType         MessageSenderType
  senderUserId       String?
  senderNameSnapshot String?
  automationRunId    String?
  content            String
  rawPayload         Json
  createdAt          DateTime          @default(now())

  business     Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderUser   User?        @relation("MessageSender", fields: [senderUserId], references: [id], onDelete: SetNull)

  @@index([businessId])
  @@index([conversationId])
  @@map("messages")
}

// ---------------------------------------------------------------------------
// Catalogo
// ---------------------------------------------------------------------------

model Product {
  id         String   @id @default(cuid())
  businessId String
  name       String
  category   String?
  price      Decimal  @db.Decimal(10, 2)
  aliases    String[] @default([])
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  business   Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]

  @@index([businessId])
  @@index([businessId, active])
  @@map("products")
}

model Promotion {
  id          String   @id @default(cuid())
  businessId  String
  title       String
  description String?
  /// Precio de la promocion como item vendible (igual que un producto). Las
  /// promociones cargadas antes de este campo quedan en 0 hasta que se editen.
  price       Decimal  @default(0) @db.Decimal(10, 2)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  business   Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]

  @@index([businessId])
  @@index([businessId, active])
  @@map("promotions")
}

// ---------------------------------------------------------------------------
// Pedidos
// ---------------------------------------------------------------------------

model Order {
  id              String           @id @default(cuid())
  businessId      String
  customerId      String
  conversationId  String?
  status          OrderStatus      @default(DRAFT)
  fulfillmentType FulfillmentType?
  total           Decimal          @default(0) @db.Decimal(10, 2)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  business     Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer     Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  conversation Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  items        OrderItem[]

  @@index([businessId])
  @@index([businessId, status])
  @@map("orders")
}

model OrderItem {
  id            String   @id @default(cuid())
  orderId       String
  productId     String?
  /// Si el item vino de una promocion en vez de un producto del catalogo.
  /// Un OrderItem nunca tiene productId Y promotionId a la vez.
  promotionId   String?
  nameSnapshot  String
  priceSnapshot Decimal  @db.Decimal(10, 2)
  quantity      Int      @default(1)
  subtotal      Decimal  @db.Decimal(10, 2)
  createdAt     DateTime @default(now())

  order     Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product?   @relation(fields: [productId], references: [id], onDelete: SetNull)
  promotion Promotion? @relation(fields: [promotionId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@map("order_items")
}

// ---------------------------------------------------------------------------
// Bot: log de transiciones de estado (auditoria)
// ---------------------------------------------------------------------------

model BotState {
  id             String             @id @default(cuid())
  conversationId String
  fromState      ConversationStatus
  toState        ConversationStatus
  intent         String
  createdAt      DateTime           @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@map("bot_states")
}

// ---------------------------------------------------------------------------
// Bot: configuracion simple por negocio (textos + palabras clave)
// ---------------------------------------------------------------------------

model BotResponseTemplate {
  id         String         @id @default(cuid())
  businessId String
  key        BotTemplateKey
  content    String
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, key])
  @@map("bot_response_templates")
}

model BotKeywordRule {
  id         String        @id @default(cuid())
  businessId String
  intent     BotIntentType
  phrase     String
  createdAt  DateTime      @default(now())

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, intent])
  @@map("bot_keyword_rules")
}
