# =============================================================================
# App
# =============================================================================
PORT=3000
NODE_ENV=development

# Origenes permitidos por CORS (REST y WebSocket), separados por coma.
# En produccion DEBE apuntar al dominio real del CRM, ej:
#   CORS_ORIGINS=https://crm.tudominio.com
# Si se deja vacio, se permite cualquier origen (solo para desarrollo local).
CORS_ORIGINS=

# URL publica de ESTE backend (sin slash final), ej. https://apicrm.tudominio.com
# El superadmin la usa para registrar el webhook de cada instancia nueva de
# Evolution API automaticamente, apuntando a {APP_URL}/webhook/whatsapp.
APP_URL=

# =============================================================================
# Database (PostgreSQL)
# =============================================================================
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/whatsapp_orders?schema=public"

# =============================================================================
# Redis / BullMQ
# =============================================================================
# Opcion A: variables sueltas (uso tipico en desarrollo local / docker-compose)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
# Opcion B: connection string unica (tipico en servicios gestionados, ej. el
# Redis desplegado por Coolify). Si se define, tiene prioridad sobre A.
# Formato: redis://[:password@]host:port  (usar rediss:// para TLS)
# REDIS_URL=redis://:password@redis-host:6379

# =============================================================================
# JWT
# =============================================================================
JWT_SECRET=change-this-secret
JWT_EXPIRES_IN=7d

# =============================================================================
# Evolution API (WhatsApp) — instancia de Evolution API YA existente en
# Coolify (el servidor/proyecto), no crear otra instalacion de Evolution.
# Cada NEGOCIO (tenant) tiene su propia instancia DENTRO de esa Evolution API,
# creada desde el panel /superadmin — no hay un EVOLUTION_INSTANCE_NAME
# global, el nombre de instancia vive en Business.whatsappInstanceId.
# =============================================================================
EVOLUTION_API_URL=https://your-evolution-api-host
EVOLUTION_API_KEY=your-evolution-api-key

# Secreto para validar que el webhook entrante viene de Evolution API
# (se compara contra el header x-webhook-secret que configures en Evolution).
# El superadmin lo usa tambien al registrar el webhook de una instancia nueva.
WHATSAPP_WEBHOOK_SECRET=change-this-webhook-secret

# =============================================================================
# POS
# =============================================================================
# Secreto para validar el webhook de estado del POS (POST /pos/webhook/status)
POS_WEBHOOK_SECRET=change-this-pos-webhook-secret

# =============================================================================
# Seguridad de login (anti fuerza bruta) — aplica a /auth/login para los
# tres roles (superadmin, ADMIN y AGENT), es un unico endpoint de login.
# =============================================================================
# Intentos de login permitidos por IP dentro de la ventana LOGIN_THROTTLE_TTL_MS.
LOGIN_THROTTLE_LIMIT=5
LOGIN_THROTTLE_TTL_MS=60000
# Intentos fallidos consecutivos (sin importar la IP) antes de bloquear LA CUENTA.
LOGIN_MAX_FAILED_ATTEMPTS=5
# Minutos que queda bloqueada la cuenta una vez alcanzado el limite anterior.
LOGIN_LOCKOUT_MINUTES=15
