# URL base del backend NestJS (REST).
# Desarrollo:  http://localhost:3000
# Produccion:  https://api.tudominio.com  (el dominio que le asignes al backend en Coolify)
VITE_API_URL=http://localhost:3000

# URL base para el WebSocket (Socket.IO). Normalmente la misma del backend;
# el cliente se conecta al namespace /realtime. Debe ser wss:// (https) en
# produccion para que el navegador permita el upgrade detras de un dominio https.
VITE_WS_URL=http://localhost:3000

# IMPORTANTE: Vite inlina estas variables en tiempo de BUILD, no de arranque
# del contenedor. Si las cambias, hay que reconstruir la imagen Docker
# (pasandolas como --build-arg VITE_API_URL=... --build-arg VITE_WS_URL=...),
# no alcanza con cambiarlas en el entorno de un contenedor ya construido.
